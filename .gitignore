# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# The docs site and the virtualenv `make docs` builds it in. Both are outputs;
# the site is published by CI from the sources under docs/.
/site/
/.venv-docs/

# A local data directory is what `make run` and docs/internals/e2e.md write
# into. Blocks are large, immutable and machine-specific — never a commit.
/mira-data/
/data/

# Staged by .github/workflows/release.yml; dist/linux/<arch>/mira is what the
# Dockerfile's `BIN=prebuilt` stage copies. Not to be confused with
# crates/mira/ui/dist, which is committed on purpose.
/dist/
/artifacts/

# The recorded-snapshot UI, built by `make ui-demo` for the documentation site.
# Not committed, unlike crates/mira/ui/dist: nothing includes it in the binary,
# and it is a derived copy of a bundle that is already in git.
/crates/mira/ui/dist-demo/

# cargo-cyclonedx output from `make sbom`
*.cdx.json

# CPython bytecode for the scripts under scripts/, written on first import.
__pycache__/

# Agent worktrees and session scratch. Never a commit.
/.claude/
