# https://editorconfig.org — what your editor should do before rustfmt, clippy
# or the UI build ever see the file. `make fmt` is still the authority for Rust;
# this exists so the diff is not half whitespace by the time it gets there.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4
max_line_length = 100

[*.toml]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

# Markdown keeps its trailing whitespace: two spaces at end of line is a hard
# break, and trimming it silently reflows the rendered page. Prose in this repo
# wraps at 80.
[*.md]
trim_trailing_whitespace = false
max_line_length = 80

[*.{js,mjs,cjs,json,css,html,svelte}]
indent_size = 2

# Make is whitespace-sensitive: a recipe line indented with spaces is a syntax
# error, not a style opinion.
[{Makefile,*.mk}]
indent_style = tab

[*.sh]
indent_size = 2

[*.proto]
indent_size = 2

# Generated by vite and committed because it is `include_bytes!`d into the
# binary. An editor that reformats it on save creates drift that CI catches as
# a red build on someone else's PR. Do not hand-edit; run `make ui`.
[crates/mira/ui/dist/**]
insert_final_newline = false
trim_trailing_whitespace = false

# Vendored upstream OpenTelemetry protos: they are a copy, and a reformatted
# copy is no longer diffable against upstream.
[crates/mira-proto/proto/**]
trim_trailing_whitespace = false

[{Cargo.lock,package-lock.json}]
insert_final_newline = false
trim_trailing_whitespace = false
