{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mira-operator values",
  "description": "Closed on purpose: additionalProperties is false at every level, so a typo'd key is an install-time error rather than a silently ignored line and a cluster running the default instead.",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "replicaCount", "rbac", "serviceAccount"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "name": { "type": "string" } },
        "required": ["name"]
      }
    },
    "nameOverride": { "type": "string", "maxLength": 63 },
    "fullnameOverride": { "type": "string", "maxLength": 63 },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "description": "Exactly one. There is no leader election in the tree (kube-rs/kube#485), so a second controller is a second independent scaling decision on the same tier. Bounded here rather than warned about, because the failure is a tier that moves two replicas for one decision and then drains a volume it did not need to."
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create"],
      "properties": {
        "create": { "type": "boolean" },
        "namespaces": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create"],
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "name": { "type": "string", "maxLength": 63 }
      }
    },
    "logLevel": { "type": "string", "minLength": 1 },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "object", "additionalProperties": { "type": ["string", "integer"] } },
        "limits": { "type": "object", "additionalProperties": { "type": ["string", "integer"] } }
      }
    },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" }
  }
}
